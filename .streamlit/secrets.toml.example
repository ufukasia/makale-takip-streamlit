# Bu dosyayı "secrets.toml" olarak kopyalayıp kendi bilgilerinle doldur.
# secrets.toml kesinlikle git'e eklenmemelidir (.gitignore'da olmalı).
#
# Streamlit Cloud'da ise bu içeriği olduğu gibi
#   Uygulama menüsü → Settings → Secrets
# kutusuna yapıştırman gerekir (dosya yüklemene gerek yok).


# ─────────────────────────────────────────────────────────────────────────
# 1) KALICI VERİTABANI (Turso) — ÖNEMLİ
# ─────────────────────────────────────────────────────────────────────────
# Streamlit Cloud'un diski GEÇİCİDİR: makine bir süre kullanılmayınca uykuya
# dalar, uyandığında repo sıfırdan kurulur ve submissions.db ilk haline döner.
# Yani öğrenci seçimleri kaybolur. Bunu önlemek için veritabanı Turso'da
# (ücretsiz, SQLite uyumlu bulut) tutulur.
#
# Nasıl alınır (5 dakika, kredi kartı istemez):
#   1. https://turso.tech → GitHub ile giriş yap.
#   2. "Create Database" → bir isim ver (ör. makale-takip), bölge: Frankfurt.
#   3. Veritabanına tıkla → "Connect" / "Connection URL" → libsql://... adresini kopyala.
#   4. Aynı ekrandan "Create Token" → çıkan uzun metni kopyala.
#   5. Aşağıya yapıştır, sonra bu bloğun başındaki # işaretlerini kaldır.
#
# [turso]
# url = "libsql://makale-takip-kullaniciadin.turso.io"
# auth_token = "eyJhbGciOiJF..."
#
# Bu blok yoksa uygulama yerel submissions.db dosyasına düşer — kendi
# bilgisayarında sorunsuz çalışır ama Streamlit Cloud'da veri kalıcı olmaz.


# ─────────────────────────────────────────────────────────────────────────
# 2) E-POSTA (öğrenci doğrulama kodu için)
# ─────────────────────────────────────────────────────────────────────────
# Gmail kullanacaksan:
#   1. Google hesabında 2 Adımlı Doğrulama'yı aç.
#   2. https://myaccount.google.com/apppasswords adresinden "Uygulama Şifresi" oluştur.
#   3. password kısmına o 16 haneli şifreyi yaz (normal şifren DEĞİL).

[smtp]
host = "smtp.gmail.com"
port = 465
user = "senin-adresin@gmail.com"
password = "uygulama-sifresi"
sender = "senin-adresin@gmail.com"

# STARTTLS kullanan bir sunucu için port 587 de çalışır:
# port = 587
